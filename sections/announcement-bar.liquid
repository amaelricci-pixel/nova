{%- liquid
  assign blocks_count = section.blocks.size
-%}
{%- if blocks_count > 0 -%}
  {%- if section.settings.style == 'marquee' -%}
    <div class="announcement announcement--marquee" style="--marquee-speed: {{ section.settings.speed | times: 8 }}s;">
      <div class="announcement__track">
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            <span{% if i == 2 %} aria-hidden="true"{% else %} {{ block.shopify_attributes }}{% endif %}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}"{% if i == 2 %} tabindex="-1"{% endif %}>{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <announcement-bar class="announcement" data-speed="{{ section.settings.speed }}">
      <div class="page-width announcement__inner">
        <div class="announcement__slides">
          {%- for block in section.blocks -%}
            <p class="announcement__slide" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </p>
          {%- endfor -%}
        </div>
      </div>
    </announcement-bar>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Barre d'annonces",
  "class": "section-announcement",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "rotate", "label": "Messages en rotation" },
        { "value": "marquee", "label": "Défilement continu" }
      ],
      "default": "rotate"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Vitesse (secondes)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Annonce",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Texte",
          "default": "Livraison offerte dès 49 € d'achat"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barre d'annonces",
      "blocks": [
        { "type": "announcement" }
      ]
    }
  ]
}
{% endschema %}
