{%- liquid
  assign style = section.settings.style
-%}
<div class="section{% if section.settings.background == 'surface' %} section--surface{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-header{% if section.settings.align == 'center' %} section-header--center{% endif %}" data-reveal>
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        </div>
        {%- if section.settings.show_view_all -%}
          <a href="{{ routes.collections_url }}" class="link">{{ 'general.navigation.view_all' | t }} {% render 'icon', name: 'arrow-right' %}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="{% if style == 'circle' %}scroller scroller--desktop-grid{% else %}grid{% endif %}" style="--cols: {{ section.settings.columns }}; --cols-tablet: {{ section.settings.columns | at_most: 3 }}; --cols-mobile: {% if style == 'circle' %}3{% else %}2{% endif %};{% if style == 'circle' %} --scroller-item: 28%;{% endif %}" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign image = block.settings.image | default: collection.featured_image
          assign title = block.settings.title | default: collection.title
          if title == blank
            assign title = 'sections.placeholder.collection_title' | t
          endif
          assign url = collection.url | default: routes.all_products_collection_url
        -%}
        <div role="listitem" data-reveal style="--reveal-index: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          {%- if style == 'circle' -%}
            <a href="{{ url }}" class="collection-card collection-card--simple">
              <div class="media media--square">
                {%- if image != blank -%}
                  {{ image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '200, 300, 400, 500', sizes: '(min-width: 1100px) 16vw, 30vw', alt: title | escape }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <span class="collection-card__title">{{ title | escape }}</span>
            </a>
          {%- else -%}
            <a href="{{ url }}" class="collection-card">
              <div class="media {% if style == 'portrait' %}media--portrait{% else %}media--square{% endif %}">
                {%- if image != blank -%}
                  {{ image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 1100px) 25vw, 50vw', alt: title | escape }}
                {%- else -%}
                  {{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="collection-card__overlay"></div>
              <div class="collection-card__info">
                <div>
                  <h3 class="collection-card__title">{{ title | escape }}</h3>
                  {%- if collection != blank and section.settings.show_count -%}
                    <span class="collection-card__count">{{ 'sections.collection_list.products_count' | t: count: collection.products_count }}</span>
                  {%- endif -%}
                </div>
                <span class="collection-card__arrow">{% render 'icon', name: 'arrow-up-right' %}</span>
              </div>
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Liste de catégories",
  "tag": "section",
  "class": "section-collection-list",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Catégories" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Achetez par univers" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "square", "label": "Cartes carrées" },
        { "value": "portrait", "label": "Cartes portrait" },
        { "value": "circle", "label": "Pastilles rondes" }
      ],
      "default": "portrait"
    },
    { "type": "range", "id": "columns", "label": "Colonnes (ordinateur)", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_count", "label": "Afficher le nombre de produits", "default": true },
    { "type": "checkbox", "id": "show_view_all", "label": "Lien « Tout voir »", "default": false },
    {
      "type": "select",
      "id": "align",
      "label": "Alignement du titre",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "center", "label": "Centré" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "default", "label": "Blanc" },
        { "value": "surface", "label": "Gris clair" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Catégorie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Titre personnalisé" },
        { "type": "image_picker", "id": "image", "label": "Image personnalisée" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Liste de catégories",
      "blocks": [
        { "type": "collection", "settings": { "title": "Chiens" } },
        { "type": "collection", "settings": { "title": "Chats" } },
        { "type": "collection", "settings": { "title": "Promenade" } },
        { "type": "collection", "settings": { "title": "Couchage" } }
      ]
    }
  ]
}
{% endschema %}
