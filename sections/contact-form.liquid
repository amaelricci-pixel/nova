<div class="section section--flush-top">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}<h2 class="h3" style="margin-bottom: 20px;">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- form 'contact', class: 'contact-form', id: 'ContactForm' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'templates.contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="contact-form__row">
        <div class="field">
          <label class="field__label" for="ContactName">{{ 'templates.contact.name' | t }}</label>
          <input class="input" id="ContactName" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
        </div>
        <div class="field">
          <label class="field__label" for="ContactEmail">{{ 'templates.contact.email' | t }} *</label>
          <input class="input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="ContactOrder">{{ 'templates.contact.order' | t }}</label>
        <input class="input" id="ContactOrder" name="contact[order]" value="{{ form.order }}">
      </div>
      <div class="field">
        <label class="field__label" for="ContactBody">{{ 'templates.contact.message' | t }} *</label>
        <textarea class="textarea" id="ContactBody" name="contact[body]" required>{{ form.body }}</textarea>
      </div>
      <div><button type="submit" class="button button--accent">{{ 'templates.contact.send' | t }}</button></div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Formulaire de contact",
  "tag": "section",
  "class": "section-contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Écrivez-nous" }
  ],
  "presets": [{ "name": "Formulaire de contact" }]
}
{% endschema %}
