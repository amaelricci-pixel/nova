{%- liquid
  assign menu_blocks = section.blocks | where: 'type', 'menu'
-%}
<footer class="footer" style="--footer-cols: {{ menu_blocks.size | at_least: 1 }};">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        {%- if settings.logo_inverse != blank -%}
          {{ settings.logo_inverse | image_url: width: 400 | image_tag: loading: 'lazy', alt: shop.name }}
        {%- else -%}
          <span class="header__logo-text">{{ shop.name | upcase }}</span>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="footer__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.show_newsletter -%}
          {%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="footer__heading" for="FooterNewsletterEmail" style="display:block;margin-bottom:12px;">{{ section.settings.newsletter_heading }}</label>
            <div class="newsletter__form">
              <input id="FooterNewsletterEmail" type="email" name="contact[email]" class="input" required autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" style="color:#fff;">
              <button type="submit" class="button button--accent button--small" aria-label="{{ 'newsletter.button' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="form-message form-message--success mt-1">{{ 'newsletter.success' | t }}</p>
            {%- elsif form.errors -%}
              <p class="form-message form-message--error mt-1">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
        {%- if section.settings.show_social -%}
          {% render 'social-icons' %}
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div class="footer__col" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'menu' -%}
              <h2 class="footer__heading">{{ block.settings.heading | default: block.settings.menu.title }}</h2>
              {%- if block.settings.menu != blank -%}
                <ul class="footer__links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- when 'text' -%}
              <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              <div class="footer__text rte">{{ block.settings.text }}</div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.show_wordmark -%}
    <div class="footer__wordmark" aria-hidden="true">{{ section.settings.wordmark | default: shop.name | upcase }}</div>
  {%- endif -%}

  <div class="page-width">
    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. {{ 'footer.rights' | t }}</p>

      {%- if section.settings.show_localization -%}
        {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
          {%- form 'localization', class: 'footer__localization' -%}
            {%- if localization.available_countries.size > 1 -%}
              <select name="country_code" class="select" onchange="this.form.submit()" aria-label="{{ 'footer.country' | t }}">
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              </select>
            {%- endif -%}
            {%- if localization.available_languages.size > 1 -%}
              <select name="locale_code" class="select" onchange="this.form.submit()" aria-label="{{ 'footer.language' | t }}">
                {%- for language in localization.available_languages -%}
                  <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                    {{ language.endonym_name | capitalize }}
                  </option>
                {%- endfor -%}
              </select>
            {%- endif -%}
            <noscript><button type="submit" class="button button--small">OK</button></noscript>
          {%- endform -%}
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_payment -%}
        <ul class="payment-icons" role="list" aria-label="{{ 'footer.payment' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 5,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte de présentation",
      "default": "<p>Des accessoires pensés pour le confort de vos animaux, sélectionnés avec exigence.</p>"
    },
    { "type": "checkbox", "id": "show_newsletter", "label": "Afficher l'inscription newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Titre newsletter", "default": "Restez informé" },
    { "type": "checkbox", "id": "show_social", "label": "Afficher les réseaux sociaux", "default": true, "info": "Liens à renseigner dans Paramètres du thème > Réseaux sociaux." },
    { "type": "checkbox", "id": "show_wordmark", "label": "Afficher le grand logo texte", "default": true },
    { "type": "text", "id": "wordmark", "label": "Texte du grand logo", "default": "NOVA" },
    { "type": "checkbox", "id": "show_localization", "label": "Sélecteur de pays / langue", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "Afficher les moyens de paiement", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Texte",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Contact" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Une question ? Écrivez-nous depuis la page contact.</p>" }
      ]
    }
  ]
}
{% endschema %}
