<div class="page-width not-found section">
  <div style="display: grid; gap: 18px; justify-items: center;">
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1 class="h2">{{ 'templates.404.title' | t }}</h1>
    <p class="text-muted">{{ 'templates.404.subtext' | t }}</p>
    <div style="display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;">
      <a href="{{ routes.all_products_collection_url }}" class="button button--accent">{{ 'cart.general.continue_shopping' | t }}</a>
      <button type="button" class="button button--outline" data-open-drawer="SearchModal">{% render 'icon', name: 'search' %} {{ 'general.search.title' | t }}</button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page 404",
  "tag": "section",
  "class": "section-404",
  "settings": []
}
{% endschema %}
