<script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>

<div class="page-width" id="MainCart">
  <div class="page-header">
    <h1>{{ 'cart.general.title' | t }}</h1>
  </div>

  {%- if cart.item_count > 0 -%}
    <cart-items class="cart-page section section--flush-top" data-section="{{ section.id }}">
      <div>
        {% render 'free-shipping' %}
        <form action="{{ routes.cart_url }}" method="post" id="CartForm" novalidate>
          {% render 'cart-line-items' %}
          <noscript><button type="submit" name="update" class="button button--outline mt-2">{{ 'cart.general.update' | t }}</button></noscript>
        </form>
      </div>

      <div class="cart-page__summary">
        <div class="cart-summary">
          {%- if settings.cart_show_note -%}
            <div class="field">
              <label class="field__label" for="CartNote">{{ 'cart.general.note' | t }}</label>
              <textarea id="CartNote" class="textarea" name="note" form="CartForm">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-summary__row" style="color: var(--color-accent);">
              <span>{{ discount.title }}</span>
              <span>-{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
          <div class="cart-summary__row cart-summary__total">
            <span>{{ 'cart.general.subtotal' | t }}</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </div>
          <p class="cart-summary__note">{{ 'cart.general.taxes_and_shipping' | t }}</p>
          <button type="submit" name="checkout" form="CartForm" class="button button--accent button--full">
            {% render 'icon', name: 'lock' %} {{ 'cart.general.checkout' | t }}
          </button>
          {%- if additional_checkout_buttons and section.settings.show_express -%}
            <div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
          <ul class="payment-icons mt-1" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag }}</li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </cart-items>
  {%- else -%}
    <div class="cart-empty section section--flush-top">
      <div class="cart-empty__icon">{% render 'icon', name: 'cart' %}</div>
      <p class="h3">{{ 'cart.general.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button button--accent">{{ 'cart.general.continue_shopping' | t }}</a>
      {%- if shop.customer_accounts_enabled and customer == nil -%}
        <p class="text-muted">{{ 'cart.general.login_html' | t: link: routes.account_login_url }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Panier",
  "tag": "section",
  "class": "section-main-cart",
  "settings": [
    { "type": "checkbox", "id": "show_express", "label": "Boutons de paiement express", "default": true }
  ]
}
{% endschema %}
