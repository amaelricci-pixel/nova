<div class="password-page">
  <div class="hero__grid-lines" aria-hidden="true"></div>
  <div class="hero__orb" aria-hidden="true"></div>
  <div class="password-page__inner">
    {%- if settings.logo_inverse != blank -%}
      {{ settings.logo_inverse | image_url: width: 400 | image_tag: alt: shop.name, style: 'margin: 0 auto; width: var(--logo-width);' }}
    {%- else -%}
      <span class="header__logo-text" style="font-size: 2.2rem;">{{ shop.name | upcase }}</span>
    {%- endif -%}
    <h1 class="h2">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p style="opacity: .7;">{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__form">
          <label for="PasswordNewsletter" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
          <input id="PasswordNewsletter" type="email" name="contact[email]" class="input" required placeholder="{{ 'newsletter.placeholder' | t }}" style="color: #fff;">
          <button type="submit" class="button button--accent">{{ 'newsletter.button' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details style="margin-top: 24px;">
      <summary style="cursor: pointer; opacity: .7; font-size: var(--fs-sm);">{{ 'templates.password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'mt-2' -%}
        {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="newsletter__form">
          <label for="StorePassword" class="visually-hidden">{{ 'templates.password.label' | t }}</label>
          <input id="StorePassword" type="password" name="password" class="input" placeholder="{{ 'templates.password.label' | t }}" style="color: #fff;" autocomplete="current-password">
          <button type="submit" class="button button--light">{{ 'templates.password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Page mot de passe",
  "tag": "section",
  "class": "section-password",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Bientôt disponible" }
  ]
}
{% endschema %}
