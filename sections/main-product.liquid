{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign media_count = product.media.size
  assign form_id = 'ProductForm-' | append: section.id
-%}

<div class="section section--tight" id="ProductInfo-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}
      <nav aria-label="{{ 'accessibility.breadcrumbs' | t }}" style="margin-bottom: 20px;">
        <ol class="breadcrumbs" role="list">
          <li><a href="{{ routes.root_url }}">{{ 'general.navigation.home' | t }}</a></li>
          {%- if collection -%}
            <li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
          {%- endif -%}
          <li aria-current="page">{{ product.title | escape }}</li>
        </ol>
      </nav>
    {%- endif -%}

    <div class="product">
      {%- comment -%} Galerie {%- endcomment -%}
      <product-gallery class="product-gallery" data-section="{{ section.id }}">
        <div class="product-gallery__main">
          <div class="product-gallery__slides" tabindex="0" aria-label="{{ 'products.product.media.gallery' | t }}">
            {%- if media_count > 0 -%}
              {%- for media in product.media -%}
                <div class="product-gallery__slide" data-media-id="{{ media.id }}">
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      {%- liquid
                        assign img_loading = 'lazy'
                        if forloop.first
                          assign img_loading = 'eager'
                        endif
                        assign zoom_url = media | image_url: width: 2400
                        assign img_alt = media.alt | default: product.title | escape
                      -%}
                      <div class="media media--{{ section.settings.media_ratio }}" data-zoom="{{ zoom_url }}" data-alt="{{ img_alt }}">
                        {{
                          media
                          | image_url: width: 1600
                          | image_tag:
                            loading: img_loading,
                            widths: '400, 600, 800, 1000, 1200, 1600',
                            sizes: '(min-width: 990px) 55vw, 100vw',
                            alt: img_alt
                        }}
                      </div>
                    {%- when 'video' -%}
                      <div class="media media--{{ section.settings.media_ratio }} media--video">
                        {{ media | video_tag: controls: true, muted: true, playsinline: true, image_size: '1200x' }}
                      </div>
                    {%- when 'external_video' -%}
                      <div class="media media--{{ section.settings.media_ratio }} media--video">
                        {{ media | external_video_tag: loading: 'lazy' }}
                      </div>
                    {%- when 'model' -%}
                      <div class="media media--{{ section.settings.media_ratio }} media--video">
                        {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
                      </div>
                  {%- endcase -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="product-gallery__slide">
                <div class="media media--square">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
              </div>
            {%- endif -%}
          </div>
          {%- if media_count > 1 -%}
            <button type="button" class="product-gallery__nav product-gallery__nav--prev hide-mobile" aria-label="{{ 'products.product.media.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
            <button type="button" class="product-gallery__nav product-gallery__nav--next hide-mobile" aria-label="{{ 'products.product.media.next' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
            <span class="product-gallery__counter" data-counter>1 / {{ media_count }}</span>
          {%- endif -%}
        </div>
        {%- if media_count > 1 -%}
          <div class="product-gallery__thumbs" role="list">
            {%- for media in product.media -%}
              <button type="button" class="product-gallery__thumb" role="listitem" aria-label="{{ 'products.product.media.go_to' | t: index: forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                <div class="media media--square">
                  {{ media.preview_image | image_url: width: 180 | image_tag: loading: 'lazy', alt: '' }}
                </div>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </product-gallery>

      {%- comment -%} Informations {%- endcomment -%}
      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'vendor' -%}
              <p class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</p>

            {%- when 'title' -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

            {%- when 'rating' -%}
              <div {{ block.shopify_attributes }}>
                {%- if product.metafields.reviews.rating.value != blank -%}
                  <a href="#reviews" style="display: inline-block;">{% render 'rating', product: product, show_count: true %}</a>
                {%- endif -%}
              </div>

            {%- when 'price' -%}
              <div class="product__price-row" {{ block.shopify_attributes }}>
                {% render 'price', product: product, variant: current_variant, use_variant: true, show_badge: true, size: 'large', section_id: section.id %}
              </div>
              {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                <p class="product__tax">
                  {%- if cart.taxes_included -%}{{ 'products.product.include_taxes' | t }}{%- endif -%}
                  {%- if shop.shipping_policy.body != blank %} {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}{%- endif -%}
                </p>
              {%- endif -%}
              {%- assign installments_id = 'ProductInstallments-' | append: section.id -%}
              {%- form 'product', product, id: installments_id -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input="{{ section.id }}">
                {{ form | payment_terms }}
              {%- endform -%}

            {%- when 'divider' -%}
              <div class="product__divider" {{ block.shopify_attributes }}></div>

            {%- when 'text' -%}
              <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <variant-picker class="variant-picker" data-section="{{ section.id }}" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign opt_name = option.name | downcase
                      assign is_color = false
                      if block.settings.swatches
                        if opt_name == 'couleur' or opt_name == 'color' or opt_name == 'colour' or opt_name == 'coloris'
                          assign is_color = true
                        endif
                      endif
                      assign is_size = false
                      if opt_name == 'taille' or opt_name == 'size' or opt_name == 'pointure'
                        assign is_size = true
                      endif
                    -%}
                    <fieldset data-position="{{ forloop.index0 }}">
                      <legend>
                        <span style="color: var(--color-text); font-weight: var(--font-body-weight-bold);">{{ option.name }} : <span data-selected-value>{{ option.selected_value }}</span></span>
                        {%- if is_size and block.settings.size_guide_page != blank -%}
                          <button type="button" class="size-guide-link" data-open-drawer="SizeGuide-{{ section.id }}">{% render 'icon', name: 'ruler', class: 'icon' %} {{ 'products.product.size_guide' | t }}</button>
                        {%- endif -%}
                      </legend>
                      <div class="variant-options">
                        {%- for value in option.values -%}
                          {%- liquid
                            assign input_id = section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0
                            assign swatch_style = ''
                            if is_color
                              assign swatch_name = value.name | downcase | remove: ' '
                              assign swatch_style = '--swatch: ' | append: swatch_name
                              if value.swatch.image
                                assign swatch_url = value.swatch.image | image_url: width: 80
                                assign swatch_style = '--swatch: url(' | append: swatch_url | append: ')'
                              elsif value.swatch.color
                                assign swatch_style = '--swatch: ' | append: value.swatch.color
                              endif
                            endif
                          -%}
                          <div class="variant-option{% if is_color %} variant-option--swatch{% endif %}">
                            <input type="radio" id="{{ input_id }}" name="{{ option.name | escape }}-{{ section.id }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                            <label for="{{ input_id }}" title="{{ value | escape }}">
                              {%- if is_color -%}
                                <span class="swatch" style="{{ swatch_style }};"></span>
                                <span class="visually-hidden">{{ value | escape }}</span>
                              {%- else -%}
                                {{ value | escape }}
                              {%- endif -%}
                            </label>
                          </div>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  <script type="application/json">
                    {{ product.variants | json }}
                  </script>
                </variant-picker>

                {%- if block.settings.size_guide_page != blank -%}
                  <nova-modal id="SizeGuide-{{ section.id }}" class="modal" aria-hidden="true">
                    <div class="modal__overlay" data-close></div>
                    <div class="modal__panel rte" role="dialog" aria-modal="true" aria-label="{{ block.settings.size_guide_page.title | escape }}" tabindex="-1">
                      <button type="button" class="icon-button modal__close" data-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
                      <h2 class="h3">{{ block.settings.size_guide_page.title }}</h2>
                      {{ block.settings.size_guide_page.content }}
                    </div>
                  </nova-modal>
                {%- endif -%}
              {%- endunless -%}

            {%- when 'inventory' -%}
              {%- liquid
                assign inv_class = ''
                if current_variant.available == false
                  assign inv_class = 'inventory--out'
                elsif current_variant.inventory_management != blank and current_variant.inventory_quantity <= block.settings.low_stock_threshold and current_variant.inventory_quantity > 0
                  assign inv_class = 'inventory--low'
                endif
              -%}
              <p class="inventory {{ inv_class }}" data-inventory data-in-stock="{{ 'products.product.in_stock' | t }}" data-out-of-stock="{{ 'products.product.sold_out' | t }}" {{ block.shopify_attributes }}>
                {%- if current_variant.available == false -%}
                  {{ 'products.product.sold_out' | t }}
                {%- elsif inv_class == 'inventory--low' -%}
                  {{ 'products.product.low_stock' | t: count: current_variant.inventory_quantity }}
                {%- else -%}
                  {{ 'products.product.in_stock' | t }}
                {%- endif -%}
              </p>

            {%- when 'buy_buttons' -%}
              <product-form class="product-form" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input="{{ section.id }}">
                  <div class="product-form__row">
                    {%- if block.settings.show_quantity -%}
                      <quantity-input class="quantity">
                        <button type="button" name="minus" aria-label="{{ 'products.product.quantity.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                        <input type="number" name="quantity" value="1" min="1" step="1" aria-label="{{ 'products.product.quantity.label' | t }}">
                        <button type="button" name="plus" aria-label="{{ 'products.product.quantity.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                      </quantity-input>
                    {%- endif -%}
                    <button
                      type="submit"
                      name="add"
                      class="button{% unless block.settings.show_dynamic_checkout %} button--accent{% endunless %}"
                      data-add-button="{{ section.id }}"
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      {% render 'icon', name: 'cart' %}
                      <span data-label>
                        {%- if current_variant.available -%}
                          {{ 'products.product.add_to_cart' | t }}
                        {%- else -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- endif -%}
                      </span>
                    </button>
                  </div>
                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                  <p class="product-form__error" data-form-error role="alert" hidden></p>
                {%- endform -%}
              </product-form>

            {%- when 'delivery' -%}
              <div class="delivery-box" {{ block.shopify_attributes }}>
                {%- if block.settings.line_1 != blank -%}
                  <div class="delivery-box__row">{% render 'icon', name: block.settings.icon_1 %}<div>{{ block.settings.line_1 }}</div></div>
                {%- endif -%}
                {%- if block.settings.line_2 != blank -%}
                  <div class="delivery-box__row">{% render 'icon', name: block.settings.icon_2 %}<div>{{ block.settings.line_2 }}</div></div>
                {%- endif -%}
                {%- if block.settings.line_3 != blank -%}
                  <div class="delivery-box__row">{% render 'icon', name: block.settings.icon_3 %}<div>{{ block.settings.line_3 }}</div></div>
                {%- endif -%}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="accordion" {{ block.shopify_attributes }}>
                  <details{% if block.settings.open %} open{% endif %}>
                    <summary>{{ 'products.product.description' | t }}<span class="accordion__icon" aria-hidden="true"></span></summary>
                    <div class="accordion__content rte">{{ product.description }}</div>
                  </details>
                </div>
              {%- endif -%}

            {%- when 'collapsible_tab' -%}
              {%- liquid
                assign tab_content = block.settings.content
                if block.settings.page != blank
                  assign tab_content = block.settings.page.content
                endif
              -%}
              {%- if tab_content != blank -%}
                <div class="accordion" style="border-top: 0;" {{ block.shopify_attributes }}>
                  <details>
                    <summary>{{ block.settings.heading }}<span class="accordion__icon" aria-hidden="true"></span></summary>
                    <div class="accordion__content rte">{{ tab_content }}</div>
                  </details>
                </div>
              {%- endif -%}

            {%- when 'sku' -%}
              <p class="product__tax" {{ block.shopify_attributes }}>{{ 'products.product.sku' | t }} : <span data-sku>{{ current_variant.sku }}</span></p>

            {%- when 'share' -%}
              <div class="share" {{ block.shopify_attributes }}>
                <button type="button" class="link" data-copy="{{ request.origin }}{{ product.url }}" data-copied-label="{{ 'products.product.link_copied' | t }}">
                  {% render 'icon', name: 'share' %} {{ 'products.product.share' | t }}
                </button>
              </div>

            {%- when 'custom_liquid' -%}
              <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- comment -%} Barre d'achat collante {%- endcomment -%}
{%- if section.settings.sticky_atc -%}
  <sticky-atc data-target="{{ form_id }}">
    <div class="sticky-atc" aria-hidden="false">
      <div class="sticky-atc__inner">
        <div class="sticky-atc__media media media--square">
          {%- if featured_media -%}{{ featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
        </div>
        <p class="sticky-atc__title">{{ product.title | escape }}</p>
        {% render 'price', product: product, variant: current_variant, use_variant: true, section_id: section.id %}
        <button type="submit" form="{{ form_id }}" class="button button--accent" data-add-button="{{ section.id }}"{% unless current_variant.available %} disabled{% endunless %}>
          <span data-label>
            {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
          </span>
        </button>
      </div>
    </div>
  </sticky-atc>
{%- endif -%}

{%- comment -%} Zoom plein écran {%- endcomment -%}
<nova-modal id="Lightbox-{{ section.id }}" class="modal modal--lightbox" aria-hidden="true">
  <div class="modal__overlay" data-close></div>
  <div class="modal__panel" role="dialog" aria-modal="true" aria-label="{{ 'products.product.media.zoom' | t }}" tabindex="-1">
    <button type="button" class="icon-button modal__close" data-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    <img src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" alt="" data-lightbox-image data-close width="1200" height="1200">
  </div>
</nova-modal>

{%- comment -%} Données structurées pour Google (SEO) {%- endcomment -%}
<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Fiche produit",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Fil d'Ariane", "default": true },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Format des médias",
      "options": [
        { "value": "square", "label": "Carré" },
        { "value": "portrait", "label": "Portrait" }
      ],
      "default": "square"
    },
    { "type": "checkbox", "id": "sticky_atc", "label": "Barre d'ajout au panier collante", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "Marque", "limit": 1 },
    { "type": "title", "name": "Titre", "limit": 1 },
    {
      "type": "rating",
      "name": "Note (avis)",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Affiche la note réelle issue de votre application d'avis (métachamp reviews.rating). Rien n'est affiché sans avis."
        }
      ]
    },
    { "type": "price", "name": "Prix", "limit": 1 },
    { "type": "divider", "name": "Séparateur" },
    { "type": "text", "name": "Texte", "settings": [{ "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Texte court de présentation.</p>" }] },
    {
      "type": "variant_picker",
      "name": "Sélecteur de variantes",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "swatches", "label": "Pastilles de couleur pour l'option Couleur", "default": true },
        {
          "type": "page",
          "id": "size_guide_page",
          "label": "Page « Guide des tailles »",
          "info": "S'affiche dans une fenêtre à côté de l'option Taille."
        }
      ]
    },
    {
      "type": "inventory",
      "name": "Disponibilité",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "low_stock_threshold", "label": "Seuil « stock faible »", "min": 1, "max": 20, "step": 1, "default": 5, "info": "Nécessite le suivi des stocks dans Shopify." }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Boutons d'achat",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Sélecteur de quantité", "default": true },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Boutons de paiement express", "default": true, "info": "Apple Pay, Google Pay, Shop Pay… selon vos réglages de paiement." }
      ]
    },
    {
      "type": "delivery",
      "name": "Livraison / garanties",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "N'indiquez que des informations exactes et conformes à vos conditions de vente." },
        { "type": "select", "id": "icon_1", "label": "Icône 1", "options": [{ "value": "truck", "label": "Camion" }, { "value": "return", "label": "Retour" }, { "value": "shield", "label": "Bouclier" }, { "value": "lock", "label": "Cadenas" }, { "value": "clock", "label": "Horloge" }, { "value": "package", "label": "Colis" }], "default": "truck" },
        { "type": "inline_richtext", "id": "line_1", "label": "Ligne 1", "default": "<strong>Livraison suivie</strong> — délai indiqué au paiement" },
        { "type": "select", "id": "icon_2", "label": "Icône 2", "options": [{ "value": "truck", "label": "Camion" }, { "value": "return", "label": "Retour" }, { "value": "shield", "label": "Bouclier" }, { "value": "lock", "label": "Cadenas" }, { "value": "clock", "label": "Horloge" }, { "value": "package", "label": "Colis" }], "default": "return" },
        { "type": "inline_richtext", "id": "line_2", "label": "Ligne 2", "default": "Retours : voir notre politique de retour" },
        { "type": "select", "id": "icon_3", "label": "Icône 3", "options": [{ "value": "truck", "label": "Camion" }, { "value": "return", "label": "Retour" }, { "value": "shield", "label": "Bouclier" }, { "value": "lock", "label": "Cadenas" }, { "value": "clock", "label": "Horloge" }, { "value": "package", "label": "Colis" }], "default": "lock" },
        { "type": "inline_richtext", "id": "line_3", "label": "Ligne 3", "default": "Paiement 100 % sécurisé" }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [{ "type": "checkbox", "id": "open", "label": "Ouverte par défaut", "default": true }]
    },
    {
      "type": "collapsible_tab",
      "name": "Onglet repliable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Livraison & retours" },
        { "type": "richtext", "id": "content", "label": "Contenu", "info": "Astuce : connectez un métachamp produit (ex. matières, entretien) avec l'icône de source dynamique." },
        { "type": "page", "id": "page", "label": "Ou contenu d'une page" }
      ]
    },
    { "type": "sku", "name": "Référence (SKU)", "limit": 1 },
    { "type": "share", "name": "Partager", "limit": 1 },
    { "type": "custom_liquid", "name": "Liquid personnalisé", "settings": [{ "type": "liquid", "id": "custom_liquid", "label": "Code Liquid" }] }
  ]
}
{% endschema %}
