<div class="section{% if section.settings.background == 'surface' %} section--surface{% elsif section.settings.background == 'dark' %} section--dark{% endif %}">
  <div class="page-width">
    <div class="rich-text{% if section.settings.align == 'left' %} rich-text--left{% endif %}" data-reveal>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <span class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- when 'heading' -%}
            <h2 class="{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'text' -%}
            <div class="rte text-muted" style="font-size: var(--fs-lg);" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            {%- if block.settings.label != blank -%}
              <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="button{% if block.settings.accent %} button--accent{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Texte enrichi",
  "tag": "section",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "select",
      "id": "align",
      "label": "Alignement",
      "options": [
        { "value": "center", "label": "Centré" },
        { "value": "left", "label": "Gauche" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Fond",
      "options": [
        { "value": "default", "label": "Blanc" },
        { "value": "surface", "label": "Gris clair" },
        { "value": "dark", "label": "Noir" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Surtitre", "settings": [{ "type": "text", "id": "text", "label": "Texte", "default": "NOVA" }] },
    {
      "type": "heading",
      "name": "Titre",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Titre", "default": "Le meilleur pour vos compagnons" },
        {
          "type": "select",
          "id": "size",
          "label": "Taille",
          "options": [
            { "value": "h2", "label": "Moyenne" },
            { "value": "h1", "label": "Grande" },
            { "value": "display", "label": "Très grande" }
          ],
          "default": "h1"
        }
      ]
    },
    { "type": "text", "name": "Texte", "settings": [{ "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Partagez l'histoire de votre marque ou présentez une collection.</p>" }] },
    {
      "type": "button",
      "name": "Bouton",
      "settings": [
        { "type": "text", "id": "label", "label": "Texte", "default": "Découvrir" },
        { "type": "url", "id": "link", "label": "Lien" },
        { "type": "checkbox", "id": "accent", "label": "Bleu électrique", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Texte enrichi",
      "blocks": [{ "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }, { "type": "button" }]
    }
  ]
}
{% endschema %}
