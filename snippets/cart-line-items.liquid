{%- comment -%}
  Lignes du panier, partagées entre le tiroir et la page panier.
{%- endcomment -%}
<ul class="cart-items" role="list">
  {%- for item in cart.items -%}
    <li class="cart-item" data-cart-item="{{ item.key }}">
      <a href="{{ item.url }}" class="media media--square" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '88px', alt: item.title }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </a>

      <div>
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__meta">
            {%- for option in item.options_with_values -%}
              {{ option.name }} : {{ option.value }}{% unless forloop.last %} · {% endunless %}
            {%- endfor -%}
          </p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <p class="cart-item__meta">{{ property.first }} : {{ property.last }}</p>
          {%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}
          <p class="cart-item__meta">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}
        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-item__discount">{% render 'icon', name: 'tag', class: 'icon' %} {{ discount.discount_application.title }} (-{{ discount.amount | money }})</p>
        {%- endfor -%}

        <div class="cart-item__actions">
          <quantity-input class="quantity quantity--small">
            <button type="button" name="minus" aria-label="{{ 'cart.general.decrease' | t: product: item.product.title | escape }}">{% render 'icon', name: 'minus', class: 'icon' %}</button>
            <input
              type="number"
              name="updates[]"
              value="{{ item.quantity }}"
              min="0"
              {% if item.variant.quantity_rule.max %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
              step="{{ item.variant.quantity_rule.increment | default: 1 }}"
              data-line-quantity="{{ forloop.index }}"
              data-key="{{ item.key }}"
              aria-label="{{ 'cart.general.quantity' | t }}"
            >
            <button type="button" name="plus" aria-label="{{ 'cart.general.increase' | t: product: item.product.title | escape }}">{% render 'icon', name: 'plus', class: 'icon' %}</button>
          </quantity-input>
          <a href="{{ item.url_to_remove }}" class="cart-item__remove" data-line-remove="{{ forloop.index }}" data-key="{{ item.key }}">
            {{- 'cart.general.remove' | t -}}
          </a>
        </div>
      </div>

      <div class="cart-item__price">
        {%- if item.original_line_price != item.final_line_price -%}
          <s class="price__compare">{{ item.original_line_price | money }}</s><br>
          <strong class="price--on-sale" style="color: var(--color-sale);">{{ item.final_line_price | money }}</strong>
        {%- else -%}
          <strong>{{ item.final_line_price | money }}</strong>
        {%- endif -%}
      </div>
    </li>
  {%- endfor -%}
</ul>
