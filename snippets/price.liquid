{%- comment -%}
  Affiche le prix d'un produit ou d'une variante.
  Paramètres :
  - product (obligatoire)
  - variant (optionnel, défaut : variante sélectionnée ou première disponible)
  - show_badge (optionnel) : affiche le pourcentage de réduction
  - size (optionnel) : 'large'
  - section_id (optionnel) : permet la mise à jour JS lors du changement de variante
  - use_variant (optionnel) : affiche le prix exact de la variante (fiche produit) au lieu de « À partir de »
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare_at = target.compare_at_price
  assign show_from = false
  if product.price_varies and variant == blank and use_variant != true
    assign show_from = true
    assign price = product.price_min
    assign compare_at = product.compare_at_price_min
  endif

  assign on_sale = false
  if compare_at > price
    assign on_sale = true
  endif

  if settings.show_currency_codes
    assign price_html = price | money_with_currency
    assign compare_html = compare_at | money_with_currency
  else
    assign price_html = price | money
    assign compare_html = compare_at | money
  endif
-%}
<div
  class="price{% if on_sale %} price--on-sale{% endif %}{% if size == 'large' %} price--large{% endif %}"
  {% if section_id %}data-price="{{ section_id }}"{% endif %}
>
  <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
  <span class="price__current">
    {%- if show_from -%}
      {{ 'products.product.price.from_price_html' | t: price: price_html }}
    {%- else -%}
      {{ price_html }}
    {%- endif -%}
  </span>
  <s class="price__compare"{% unless on_sale %} hidden{% endunless %}>
    {%- if on_sale %}{{ compare_html }}{% endif -%}
  </s>
  {%- if show_badge -%}
    <span class="badge badge--sale" data-sale-badge{% unless on_sale %} hidden{% endunless %}>
      {%- if on_sale -%}
        -{{ compare_at | minus: price | times: 100.0 | divided_by: compare_at | round }}%
      {%- endif -%}
    </span>
  {%- endif -%}
  {%- if target.unit_price_measurement -%}
    <span class="price__unit">
      {{ target.unit_price | money }}/
      {%- if target.unit_price_measurement.reference_value != 1 -%}
        {{ target.unit_price_measurement.reference_value }}
      {%- endif -%}
      {{ target.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>
