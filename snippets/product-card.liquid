{%- comment -%}
  Carte produit.
  Paramètres :
  - product (obligatoire)
  - index (optionnel) : ordre pour l'animation d'apparition
  - section_id (optionnel)
  - lazy (optionnel, défaut true)
{%- endcomment -%}
{%- liquid
  assign ratio = settings.card_image_ratio
  assign media_class = 'media--square'
  if ratio == 'portrait'
    assign media_class = 'media--portrait'
  endif
  assign aspect_style = ''
  if ratio == 'adapt' and product.featured_media
    assign media_class = ''
    assign aspect_style = 'aspect-ratio: ' | append: product.featured_media.aspect_ratio | append: ';'
  endif

  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif

  assign secondary = nil
  if settings.card_show_secondary_image and product.media.size > 1 and product.media[1].media_type == 'image'
    assign secondary = product.media[1]
  endif

  assign variant = product.selected_or_first_available_variant
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif

  assign is_new = false
  for tag in product.tags
    assign t = tag | downcase
    if t == 'nouveau' or t == 'new' or t == 'nouveauté'
      assign is_new = true
    endif
  endfor

  assign color_option = nil
  for option in product.options_with_values
    assign opt_name = option.name | downcase
    if opt_name == 'couleur' or opt_name == 'color' or opt_name == 'colour' or opt_name == 'coloris'
      assign color_option = option
    endif
  endfor
-%}
<div class="card" data-reveal style="--reveal-index: {{ index | default: 0 | modulo: 8 }};">
  <div class="card__media">
    <div class="media {{ media_class }}" style="{{ aspect_style }}">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 900
          | image_tag:
            loading: loading,
            widths: '240, 360, 480, 640, 900',
            sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw',
            alt: product.featured_media.alt | default: product.title | escape
        }}
        {%- if secondary -%}
          {{
            secondary
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '240, 360, 480, 640, 900',
              sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw',
              alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="card__badges">
      {%- if product.available == false -%}
        <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
      {%- elsif on_sale -%}
        <span class="badge badge--sale">
          {%- if settings.card_show_sale_percent -%}
            -{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%
          {%- else -%}
            {{ 'products.product.on_sale' | t }}
          {%- endif -%}
        </span>
      {%- endif -%}
      {%- if is_new -%}
        <span class="badge badge--new">{{ 'products.product.new' | t }}</span>
      {%- endif -%}
    </div>

    {%- if settings.card_quick_add and product.available -%}
      <div class="card__quick-add">
        {%- if product.has_only_default_variant or product.variants.size == 1 -%}
          <product-form data-ajax="true">
            {%- form 'product', product, id: nil, novalidate: 'novalidate' -%}
              <input type="hidden" name="id" value="{{ variant.id }}">
              <button type="submit" class="button button--small" aria-label="{{ 'products.product.add_to_cart' | t }} — {{ product.title | escape }}">
                {% render 'icon', name: 'plus', class: 'icon' %}
                <span>{{ 'products.product.quick_add' | t }}</span>
              </button>
            {%- endform -%}
          </product-form>
        {%- else -%}
          <a href="{{ product.url }}" class="button button--small" aria-label="{{ 'products.product.choose_options' | t }} — {{ product.title | escape }}">
            {% render 'icon', name: 'plus', class: 'icon' %}
            <span>{{ 'products.product.choose_options' | t }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="card__info">
    {%- if settings.card_show_vendor -%}
      <span class="card__vendor">{{ product.vendor }}</span>
    {%- endif -%}
    <h3 class="card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>
    {%- if settings.card_show_rating -%}
      {% render 'rating', product: product, show_count: true %}
    {%- endif -%}
    {% render 'price', product: product %}
    {%- if color_option and color_option.values.size > 1 -%}
      {%- assign color_key = 'option' | append: color_option.position -%}
      <div class="card__swatches" role="group" aria-label="{{ color_option.name | escape }}">
        {%- for value in color_option.values limit: 6 -%}
          {%- liquid
            assign swatch_variant = nil
            for v in product.variants
              if v[color_key] == value.name
                assign swatch_variant = v
                break
              endif
            endfor
          -%}
          {%- capture swatch_value -%}{% render 'swatch-color', value: value %}{%- endcapture -%}
          <button
            type="button"
            class="card__swatch"
            style="--swatch: {{ swatch_value | strip }};"
            title="{{ value | escape }}"
            aria-label="{{ value | escape }}"
            aria-pressed="false"
            {%- if swatch_variant %}
              data-variant-url="{{ swatch_variant.url }}"
              {%- if swatch_variant.featured_media %}
                data-image="{{ swatch_variant.featured_media | image_url: width: 900 }}"
                data-srcset="{{ swatch_variant.featured_media | image_url: width: 360 }} 360w, {{ swatch_variant.featured_media | image_url: width: 480 }} 480w, {{ swatch_variant.featured_media | image_url: width: 640 }} 640w, {{ swatch_variant.featured_media | image_url: width: 900 }} 900w"
              {%- endif -%}
            {%- endif %}
          ></button>
        {%- endfor -%}
        {%- if color_option.values.size > 6 -%}
          <span class="card__more">+{{ color_option.values.size | minus: 6 }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
