<div class="page-width">
  <div class="account">
    <div id="Login">
      <h1 class="h2">{{ 'customer.login.title' | t }}</h1>
      {%- form 'customer_login', novalidate: 'novalidate', class: 'mt-3' -%}
        {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field">
          <label class="field__label" for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
          <input class="input" type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" required>
        </div>
        {%- if form.password_needed -%}
          <div class="field">
            <label class="field__label" for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
            <input class="input" type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" required>
          </div>
          <a href="#Recover" class="link" style="font-weight: 400;">{{ 'customer.login.forgot_password' | t }}</a>
        {%- endif -%}
        <button type="submit" class="button button--accent button--full">{{ 'customer.login.sign_in' | t }}</button>
        <a href="{{ routes.account_register_url }}" class="button button--outline button--full">{{ 'customer.login.create_account' | t }}</a>
      {%- endform -%}
    </div>

    <div id="Recover">
      <h2 class="h4">{{ 'customer.recover.title' | t }}</h2>
      <p class="text-muted">{{ 'customer.recover.subtext' | t }}</p>
      {%- form 'recover_customer_password', class: 'mt-2' -%}
        {%- if form.posted_successfully? -%}<p class="form-message form-message--success">{{ 'customer.recover.success' | t }}</p>{%- endif -%}
        {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <input class="input" type="email" name="email" autocomplete="email" required aria-label="{{ 'customer.login.email' | t }}" placeholder="{{ 'customer.login.email' | t }}">
        <button type="submit" class="button button--outline">{{ 'customer.recover.submit' | t }}</button>
      {%- endform -%}
    </div>

    {%- if shop.checkout.guest_login -%}
      {%- form 'guest_login' -%}
        <button type="submit" class="button button--outline button--full">{{ 'customer.login.guest' | t }}</button>
      {%- endform -%}
    {%- endif -%}
  </div>
</div>
