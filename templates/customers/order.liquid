<div class="page-width">
  <div class="account account--wide">
    <a href="{{ routes.account_url }}" class="link">{% render 'icon', name: 'arrow-left' %} {{ 'customer.account.return' | t }}</a>
    <h1 class="h2">{{ 'customer.order.title' | t: name: order.name }}</h1>
    <p class="text-muted">{{ order.created_at | time_tag: format: 'date_at_time' }}</p>
    {%- if order.cancelled -%}
      {%- assign cancelled_date = order.cancelled_at | date: '%d/%m/%Y' -%}
      <p class="form-message form-message--error">{{ 'customer.order.cancelled' | t: date: cancelled_date }}</p>
    {%- endif -%}
    <div style="overflow-x: auto;">
      <table>
        <thead><tr><th>{{ 'customer.order.product' | t }}</th><th>{{ 'customer.order.quantity' | t }}</th><th>{{ 'customer.order.total' | t }}</th></tr></thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr>
              <td>{{ line_item.title | link_to: line_item.product.url }}
                {%- if line_item.fulfillment -%}<br><small class="text-muted">{{ line_item.fulfillment.tracking_company }} {% if line_item.fulfillment.tracking_url %}<a href="{{ line_item.fulfillment.tracking_url }}" class="link">{{ line_item.fulfillment.tracking_number }}</a>{% endif %}</small>{%- endif -%}
              </td>
              <td>{{ line_item.quantity }}</td>
              <td>{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr><td colspan="2">{{ 'customer.order.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
          {%- for shipping_method in order.shipping_methods -%}<tr><td colspan="2">{{ shipping_method.title }}</td><td>{{ shipping_method.price | money }}</td></tr>{%- endfor -%}
          {%- for tax_line in order.tax_lines -%}<tr><td colspan="2">{{ tax_line.title }} ({{ tax_line.rate_percentage }}%)</td><td>{{ tax_line.price | money }}</td></tr>{%- endfor -%}
          <tr><td colspan="2"><strong>{{ 'customer.order.total' | t }}</strong></td><td><strong>{{ order.total_net_amount | money_with_currency }}</strong></td></tr>
        </tfoot>
      </table>
    </div>
    <div style="display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
      <div><h2 class="h4">{{ 'customer.order.billing_address' | t }}</h2>{{ order.billing_address | format_address }}</div>
      <div><h2 class="h4">{{ 'customer.order.shipping_address' | t }}</h2>{{ order.shipping_address | format_address }}</div>
    </div>
  </div>
</div>
