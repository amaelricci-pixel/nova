<div class="page-width">
  <div class="account">
    <h1 class="h2">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field">
        <label class="field__label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
        <input class="input" type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name" value="{{ form.first_name }}">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
        <input class="input" type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name" value="{{ form.last_name }}">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterEmail">{{ 'customer.login.email' | t }}</label>
        <input class="input" type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" value="{{ form.email }}" required>
      </div>
      <div class="field">
        <label class="field__label" for="RegisterPassword">{{ 'customer.login.password' | t }}</label>
        <input class="input" type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required>
      </div>
      <label class="checkbox"><input type="checkbox" name="customer[accepts_marketing]" value="true"> {{ 'customer.register.marketing' | t }}</label>
      <button type="submit" class="button button--accent button--full">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
